# Copy to .env.local (not committed). Used by the UI at build/dev time.
# You can still override these URLs in the sidebar; they are stored per env.

VITE_DEFAULT_ENV=dev

# Data Recon API origin (no trailing slash)
VITE_DEV_BACKEND_URL=http://localhost:8080
# Optional separate agent service. Leave empty to use the built-in local agent against the backend.
VITE_DEV_AGENT_URL=

VITE_UAT_BACKEND_URL=
VITE_UAT_AGENT_URL=

VITE_SIT_BACKEND_URL=
VITE_SIT_AGENT_URL=

VITE_PROD_BACKEND_URL=
VITE_PROD_AGENT_URL=
